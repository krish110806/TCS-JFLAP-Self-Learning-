<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="[q0]">
			<x>120.0</x>
			<y>180.0</y>
			<label>State A: No suffix match</label>
			<initial/>
		</state>
		<state id="1" name="[q0,q1]">
			<x>300.0</x>
			<y>180.0</y>
			<label>State B: Suffix 'a'</label>
		</state>
		<state id="2" name="[q0,q2]">
			<x>480.0</x>
			<y>180.0</y>
			<label>State C: Suffix 'ab' (Accepting)</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>b</read>
		</transition>
		<transition>
			<from>2</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>2</from>
			<to>0</to>
			<read>b</read>
		</transition>
	</automaton>
</structure>
