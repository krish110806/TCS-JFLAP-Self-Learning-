<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>turing</type>\n\t<tapes>1</tapes>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q_scan">
			<x>140.0</x>
			<y>180.0</y>
			<label>Scan Right to Blank</label>
			<initial/>
		</state>
		<state id="1" name="q_carry">
			<x>380.0</x>
			<y>180.0</y>
			<label>Ripple Carry Left</label>
		</state>
		<state id="2" name="q_halt">
			<x>620.0</x>
			<y>180.0</y>
			<label>Halt (Accepting)</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>0</read>
			<write>0</write>
			<move>R</move>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>1</read>
			<write>1</write>
			<move>R</move>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read/>
			<write/>
			<move>L</move>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>1</read>
			<write>0</write>
			<move>L</move>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>0</read>
			<write>1</write>
			<move>R</move>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read/>
			<write>1</write>
			<move>R</move>
		</transition>
	</automaton>
</structure>
